{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "APP_DEMO_MODE=1 next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "verify:full": "pnpm verify && pnpm test:e2e",
    "demo:prep": "pnpm db:reset && pnpm build",
    "demo:check": "tsx scripts/db.ts demo-check",
    "demo": "APP_DEMO_MODE=1 next start -H 127.0.0.1 -p 3000",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "db:unlock": "tsx scripts/db.ts unlock",
    "db:backup": "tsx scripts/db.ts backup",
    "db:restore": "tsx scripts/db.ts restore",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:db && pnpm build && pnpm test:smoke"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "^1.5.0",
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-tools": "0.4.11",
    "@react-pdf/renderer": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "signature_pad": "5.1.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pdfjs-dist": "6.5.438",
