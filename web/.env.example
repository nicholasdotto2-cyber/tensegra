# Gli script (pnpm db:*, pnpm test:smoke) leggono gli stessi file di Next: .env e .env.local
# Nome del prodotto mostrato nell'interfaccia (facoltativo)
NEXT_PUBLIC_APP_NAME=
# Cartella dei dati locali, relativa a web/ (default .data)
# APP_DATA_DIR=.data
# Ora fissa per test e prove, ISO 8601 con fuso (vuota = ora reale)
# APP_FIXED_NOW=2026-11-04T08:30:00+01:00
# 1 = modalità demo (banner, "Ricrea i dati di prova")
# APP_DEMO_MODE=1
